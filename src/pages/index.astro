---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Dashboard" activePath="/">
  <div id="dashboard-content">
    <p class="text-base-content/50">Loading...</p>
  </div>
  <script>
    import { getState, updateState } from '../lib/store';
    import { isOverdue, isDueSoon, formatRelativeTime, formatTime, formatElapsed } from '../lib/utils';

    function render() {
      const state = getState();
      const shift = state.currentShiftId ? state.shifts.find(s => s.id === state.currentShiftId) ?? null : null;
      const activePatients = state.patients.filter(p => p.isActive).sort((a, b) => {
        const order: Record<string, number> = { critical: 0, watch: 1, routine: 2 };
        return order[a.priority] - order[b.priority];
      });
      const pendingTasks = state.tasks.filter(t => t.status === 'pending');
      const overdueTasks = pendingTasks.filter(t => isOverdue(t.dueTime)).slice(0, 5);
      const dueSoonTasks = pendingTasks.filter(t => isDueSoon(t.dueTime, 60) && !isOverdue(t.dueTime)).slice(0, 3);

      const container = document.getElementById('dashboard-content')!;
      container.innerHTML = `
        <h1 class="text-2xl font-bold mb-4">Dashboard</h1>
        
        ${shift ? `
          <div class="card bg-primary text-primary-content mb-4">
            <div class="card-body">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="card-title">Active Shift</h2>
                  <p>Ward: ${shift.ward} &bull; ${shift.nurseInitials}</p>
                  <p class="text-sm opacity-80" id="elapsed-time">Elapsed: ${formatElapsed(shift.startTime)}</p>
                </div>
                <button id="end-shift-btn" class="btn btn-error btn-sm">End Shift</button>
              </div>
            </div>
          </div>
        ` : `
          <div class="card bg-base-200 mb-4">
            <div class="card-body text-center">
              <h2 class="card-title justify-center">No Active Shift</h2>
              <p class="text-base-content/70">Start a shift to begin tracking patients and tasks.</p>
              <div class="card-actions justify-center">
                <a href="/shift" class="btn btn-primary">Start Shift</a>
              </div>
            </div>
          </div>
        `}

        ${overdueTasks.length > 0 ? `
          <div class="mb-4">
            <h2 class="text-lg font-semibold text-error mb-2">&#9888; Overdue Tasks (${overdueTasks.length})</h2>
            ${overdueTasks.map(t => {
              const patient = t.patientId ? state.patients.find(p => p.id === t.patientId) : null;
              return `<div class="alert alert-error mb-2 cursor-pointer" onclick="window.location.href='/tasks'">
                <span><strong>${t.description}</strong>${patient ? ` — ${patient.roomNumber}` : ''} — due ${t.dueTime ? formatTime(t.dueTime) : 'ASAP'}</span>
              </div>`;
            }).join('')}
          </div>
        ` : ''}

        ${dueSoonTasks.length > 0 ? `
          <div class="mb-4">
            <h2 class="text-lg font-semibold text-warning mb-2">&#8987; Due Soon</h2>
            ${dueSoonTasks.map(t => {
              const patient = t.patientId ? state.patients.find(p => p.id === t.patientId) : null;
              return `<div class="alert alert-warning mb-2 cursor-pointer" onclick="window.location.href='/tasks'">
                <span><strong>${t.description}</strong>${patient ? ` — ${patient.roomNumber}` : ''} — due ${t.dueTime ? formatTime(t.dueTime) : 'ASAP'}</span>
              </div>`;
            }).join('')}
          </div>
        ` : ''}

        <div>
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-lg font-semibold">Patients (${activePatients.length})</h2>
            <a href="/patients" class="link text-sm">View all</a>
          </div>
          ${activePatients.length === 0 ? `<p class="text-base-content/50 text-sm">No active patients. <a href="/patients" class="link">Add patients</a>.</p>` : ''}
          <div class="grid gap-3">
            ${activePatients.map(p => {
              const patientTasks = state.tasks.filter(t => t.patientId === p.id && t.status === 'pending');
              const patientNotes = state.notes.filter(n => n.patientId === p.id);
              const lastNote = patientNotes.sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime())[0];
              const priorityBadge = p.priority === 'critical' ? 'badge-error' : p.priority === 'watch' ? 'badge-warning' : 'badge-ghost';
              return `
                <a href="/patient?id=${p.id}" class="card bg-base-200 hover:bg-base-300 transition-colors cursor-pointer">
                  <div class="card-body p-4">
                    <div class="flex items-start justify-between">
                      <div>
                        <div class="flex items-center gap-2">
                          <span class="text-lg font-bold">${p.roomNumber}</span>
                          <span class="badge ${priorityBadge} badge-sm">${p.priority}</span>
                        </div>
                        <p class="text-sm text-base-content/70">${p.alias}</p>
                        <div class="flex flex-wrap gap-1 mt-1">
                          ${p.tags.map(tag => `<span class="badge badge-ghost badge-sm">${tag}</span>`).join('')}
                        </div>
                      </div>
                      <div class="text-right text-sm">
                        <p>${patientTasks.length} pending task${patientTasks.length !== 1 ? 's' : ''}</p>
                        ${lastNote ? `<p class="text-base-content/50">${formatRelativeTime(lastNote.timestamp)}</p>` : ''}
                      </div>
                    </div>
                  </div>
                </a>
              `;
            }).join('')}
          </div>
        </div>
      `;

      const endShiftBtn = document.getElementById('end-shift-btn');
      if (endShiftBtn) {
        endShiftBtn.addEventListener('click', () => {
          if (confirm('End the current shift?')) {
            updateState(s => ({
              ...s,
              currentShiftId: null,
              shifts: s.shifts.map(sh => sh.id === s.currentShiftId ? { ...sh, endTime: new Date().toISOString() } : sh),
              patients: s.patients.map(p => ({ ...p, isActive: false })),
            }));
            window.location.href = '/handoff';
          }
        });
      }

      if (shift) {
        setInterval(() => {
          const el = document.getElementById('elapsed-time');
          if (el) el.textContent = `Elapsed: ${formatElapsed(shift.startTime)}`;
        }, 60000);
      }
    }

    render();
  </script>

  <div class="md:hidden fixed bottom-20 right-4 z-40 fab">
    <button onclick="document.getElementById('fab-modal').showModal()" class="btn btn-circle btn-primary btn-lg shadow-lg" aria-label="Quick add">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
    </button>
  </div>

  <dialog id="fab-modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box">
      <h3 class="font-bold text-lg mb-4">Quick Add</h3>
      <div class="flex flex-col gap-3">
        <a href="/tasks" class="btn btn-primary">Add Task</a>
        <a href="/patients" class="btn btn-secondary">Add Note</a>
      </div>
      <div class="modal-action">
        <form method="dialog"><button class="btn">Close</button></form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
</BaseLayout>
