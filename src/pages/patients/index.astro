---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Patients" activePath="/patients">
  <div id="patients-content">
    <p class="text-base-content/50">Loading...</p>
  </div>
  <script>
    import { getState, updateState } from '../../lib/store';
    import { formatRelativeTime } from '../../lib/utils';

    function render(searchQuery = '') {
      const state = getState();
      let patients = state.patients.filter(p => p.isActive);
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        patients = patients.filter(p => p.roomNumber.toLowerCase().includes(q) || p.alias.toLowerCase().includes(q));
      }
      patients.sort((a, b) => {
        const order: Record<string, number> = { critical: 0, watch: 1, routine: 2 };
        return order[a.priority] - order[b.priority];
      });

      const container = document.getElementById('patients-content')!;
      container.innerHTML = `
        <div class="flex items-center justify-between mb-4">
          <h1 class="text-2xl font-bold">Patients</h1>
          <button id="add-patient-btn" class="btn btn-primary btn-sm">+ Add Patient</button>
        </div>
        <div class="mb-4">
          <input type="text" id="search" placeholder="Search by room or name..." class="input input-bordered w-full" value="${searchQuery}" />
        </div>

        <div id="add-patient-form" class="card bg-base-200 mb-4 hidden">
          <div class="card-body">
            <h2 class="card-title">Add Patient</h2>
            <form id="patient-form" class="flex flex-col gap-3">
              <div class="form-control">
                <label class="label" for="room"><span class="label-text">Room number</span></label>
                <input type="text" id="room" class="input input-bordered" placeholder="e.g. 4B-12" required />
              </div>
              <div class="form-control">
                <label class="label" for="alias"><span class="label-text">Alias / shorthand</span></label>
                <input type="text" id="alias" class="input input-bordered" placeholder="e.g. Bed 4, Hip Fx lady" required />
              </div>
              <div class="form-control">
                <label class="label" for="priority"><span class="label-text">Priority</span></label>
                <select id="priority" class="select select-bordered">
                  <option value="routine">Routine</option>
                  <option value="watch">Watch</option>
                  <option value="critical">Critical</option>
                </select>
              </div>
              <div class="form-control">
                <label class="label" for="tags"><span class="label-text">Tags (comma-separated)</span></label>
                <input type="text" id="tags" class="input input-bordered" placeholder="e.g. fall risk, NPO" />
              </div>
              <div class="flex gap-2">
                <button type="submit" class="btn btn-primary">Add</button>
                <button type="button" id="cancel-add-btn" class="btn btn-ghost">Cancel</button>
              </div>
            </form>
          </div>
        </div>

        <div class="grid gap-3" id="patient-list">
          ${patients.length === 0 ? `<p class="text-base-content/50 text-sm text-center py-8">No active patients${searchQuery ? ' matching your search' : ''}.</p>` : ''}
          ${patients.map(p => {
            const pendingTasks = state.tasks.filter(t => t.patientId === p.id && t.status === 'pending');
            const notes = state.notes.filter(n => n.patientId === p.id).sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());
            const lastNote = notes[0];
            const priorityBadge = p.priority === 'critical' ? 'badge-error' : p.priority === 'watch' ? 'badge-warning' : 'badge-ghost';
            return `
              <a href="/patient?id=${p.id}" class="card card-compact bg-base-200 hover:bg-base-300 transition-colors">
                <div class="card-body">
                  <div class="flex items-start justify-between">
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="text-xl font-bold">${p.roomNumber}</span>
                        <span class="badge ${priorityBadge} badge-sm">${p.priority}</span>
                      </div>
                      <p class="text-base-content/70">${p.alias}</p>
                      <div class="flex flex-wrap gap-1 mt-1">
                        ${p.tags.map(tag => `<span class="badge badge-ghost badge-sm">${tag}</span>`).join('')}
                      </div>
                    </div>
                    <div class="text-right text-sm text-base-content/70">
                      <p>${pendingTasks.length} task${pendingTasks.length !== 1 ? 's' : ''}</p>
                      ${lastNote ? `<p>${formatRelativeTime(lastNote.timestamp)}</p>` : '<p>No notes</p>'}
                    </div>
                  </div>
                </div>
              </a>
            `;
          }).join('')}
        </div>
      `;

      document.getElementById('search')!.addEventListener('input', (e) => {
        render((e.target as HTMLInputElement).value);
      });

      document.getElementById('add-patient-btn')!.addEventListener('click', () => {
        document.getElementById('add-patient-form')!.classList.remove('hidden');
      });
      document.getElementById('cancel-add-btn')!.addEventListener('click', () => {
        document.getElementById('add-patient-form')!.classList.add('hidden');
      });

      document.getElementById('patient-form')!.addEventListener('submit', (e) => {
        e.preventDefault();
        const room = (document.getElementById('room') as HTMLInputElement).value.trim();
        const alias = (document.getElementById('alias') as HTMLInputElement).value.trim();
        const priority = (document.getElementById('priority') as HTMLSelectElement).value as 'routine' | 'watch' | 'critical';
        const tagsRaw = (document.getElementById('tags') as HTMLInputElement).value;
        const tags = tagsRaw.split(',').map(t => t.trim()).filter(Boolean);
        updateState(s => ({
          ...s,
          patients: [...s.patients, {
            id: crypto.randomUUID(),
            roomNumber: room,
            alias,
            admittedDate: new Date().toISOString(),
            isActive: true,
            priority,
            tags,
          }],
        }));
        render(searchQuery);
      });
    }

    render();
  </script>
</BaseLayout>
